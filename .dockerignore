# Keep the build context small. Without this, the context includes venv/,
# node_modules/ and the live Postgres data directory -- slow, and Docker can
# fail reading database files that are currently open.

.git/
.vscode/

# Python
venv/
# Leading **/ is required: a bare "__pycache__/" only matches at the root.
**/__pycache__/
**/*.py[cod]

# Node
node_modules/
npm-debug.log*
# Same leading-**/ rule as __pycache__ above, and it matters more here: the live
# session lives at src/js/.wwebjs_auth, so the bare form matched nothing and
# baked WhatsApp credentials into every image.
**/.wwebjs_cache/
**/.wwebjs_auth/

# Puppeteer's Chromium download (see .puppeteerrc.cjs) -- ~500MB of Windows
# binaries that the Linux image has no use for.
.cache/

# Runtime state -- never belongs in an image
snitch_bot_postgres_data/
logs/
data/

# Secrets
config/.env
config/*.env
.google/

# Not needed at build time. package-lock.json is deliberately absent from this
# list: `npm ci` in Dockerfile.fly refuses to run without it.
assets/
README.md
CLAUDE.md
docker-compose.yaml
requirements.txt
